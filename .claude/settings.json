{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_own_words.py\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Bash(sed -i:*)",
      "Bash(sed --in-place:*)",
      "Bash(perl -i:*)",
      "Bash(perl -pi:*)",
      "Bash(perl -pi -e:*)",
      "Bash(awk -i:*)",
      "Bash(gawk -i:*)",
      "Bash(tee:*)",
      "Bash(truncate:*)",
      "Bash(dd:*)"
    ]
  }
}
